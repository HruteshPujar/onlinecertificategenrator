# Django Security
SECRET_KEY=your-production-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Database (PostgreSQL URL from Supabase, Neon, or Vercel Postgres)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Email Settings (SMTP - Gmail, SendGrid, Resend, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=OCMS <your_email@gmail.com>
